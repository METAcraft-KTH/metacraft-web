# Museum Collection Competition: the MySQL/MariaDB database the museum-collection mod writes to.
# The website only reads it, so give this user SELECT on the two tables and nothing else.
# While MUSEUM_DB_HOST is unset the API under /smp/museum/api answers 503.
MUSEUM_DB_HOST=
MUSEUM_DB_PORT=3306
MUSEUM_DB_NAME=metacraft
MUSEUM_DB_USER=metacraft
MUSEUM_DB_PASSWORD=
# The mod's database.table_prefix
MUSEUM_DB_TABLE_PREFIX=museum_
