# East vs West vs Rest: the MySQL/MariaDB database the east-vs-west mod writes to.
# The website only reads it, so give this user SELECT on the two tables and nothing else.
# While EVW_DB_HOST is unset the API under /smp/eastvswestvsrest/api answers 503.
EVW_DB_HOST=
EVW_DB_PORT=3306
EVW_DB_NAME=metacraft
EVW_DB_USER=metacraft
EVW_DB_PASSWORD=
# The mod's database.table_prefix
EVW_DB_TABLE_PREFIX=evw_
